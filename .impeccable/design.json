  "components": [
    {
      "name": "Finds CTA Bar",
      "kind": "button",
      "refersTo": "finds-cta",
      "scope": "public-shop",
      "description": "Ink bar at the foot of every chip; fills with the family deep on hover.",
      "html": "<a class=\"ds-finds-go\" href=\"#\" style=\"--deep:#741c30\">See it on Amazon <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M3 8h10M8.5 3.5 13 8l-4.5 4.5\"/></svg></a>",
      "css": ".ds-finds-go{display:flex;justify-content:space-between;align-items:center;gap:8px;width:260px;background:#16161b;color:#fff;text-decoration:none;font:700 14px/1.5 \"Hanken Grotesk\",system-ui,sans-serif;padding:13px 12px;transition:background .2s}.ds-finds-go svg{width:16px;height:16px}.ds-finds-go:hover{background:var(--deep)}.ds-finds-go:focus-visible{outline:3px solid #16161b;outline-offset:3px}"
    },
    {
      "name": "Finds Chip",
      "kind": "card",
      "refersTo": "finds-chip",
      "scope": "public-shop",
      "description": "Photo, tone body, name, chip number, facts, ink CTA bar.",
      "html": "<article class=\"ds-finds-chip\" style=\"--tone:#f4adb6;--deep:#741c30\"><div class=\"ds-finds-photo\"></div><div class=\"ds-finds-body\"><h3>Toner Pads Zero Pore 2.0</h3><span class=\"ds-finds-no\">IF 004</span><ul><li>Exfoliating</li><li>Toning</li></ul><a class=\"ds-finds-cta\" href=\"#\">See it on Amazon &#8594;</a></div></article>",
      "css": ".ds-finds-chip{width:240px;display:flex;flex-direction:column;background:var(--tone);border-radius:6px;overflow:hidden;box-shadow:0 1px 2px rgb(22 22 27/.08),0 10px 22px -14px rgb(22 22 27/.35);font-family:\"Hanken Grotesk\",system-ui,sans-serif}.ds-finds-photo{aspect-ratio:1/1;background:#fff}.ds-finds-body{padding:12px 12px 0;color:var(--deep)}.ds-finds-body h3{font:700 19px/1.12 \"Bricolage Grotesque\",system-ui,sans-serif;letter-spacing:-.015em;margin:0 0 3px}.ds-finds-no{display:block;margin-bottom:8px;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:.02em}.ds-finds-body ul{list-style:none;margin:0 0 12px;padding:0;font-size:14px}.ds-finds-body li::before{content:\"\";display:inline-block;width:6px;height:6px;border-radius:1px;background:var(--deep);margin:0 7px 2px 0}.ds-finds-cta{display:block;margin:0 -12px;background:#16161b;color:#fff;font-weight:700;font-size:14px;padding:13px 12px;text-decoration:none;transition:background .2s}.ds-finds-cta:hover{background:var(--deep)}.ds-finds-cta:focus-visible{outline:3px solid #16161b;outline-offset:3px}"
    },
    {
      "name": "Finds Rack Strip",
      "kind": "custom",
      "refersTo": "finds-chip",
      "scope": "public-shop",
      "description": "Three-shade category strip that jumps to its section; pulls up on hover.",
      "html": "<a class=\"ds-finds-strip\" href=\"#\" style=\"--pale:#e2f0de;--tone:#9fcd95;--deep:#1c4526\"><span class=\"ds-s1\">Supplements &amp; Wellness</span><span class=\"ds-s2\">Hyaluronic Acid · Multi Collagen</span><span class=\"ds-s3\">2 finds <b>&#8595;</b></span></a>",
      "css": ".ds-finds-strip{display:flex;flex-direction:column;width:200px;border-radius:6px;overflow:hidden;text-decoration:none;font-family:\"Hanken Grotesk\",system-ui,sans-serif;box-shadow:0 1px 2px rgb(22 22 27/.08),0 10px 22px -14px rgb(22 22 27/.35);transition:transform .45s cubic-bezier(.16,1,.3,1),box-shadow .45s cubic-bezier(.16,1,.3,1)}.ds-finds-strip:hover{transform:translateY(-10px);box-shadow:0 2px 4px rgb(22 22 27/.1),0 24px 32px -16px rgb(22 22 27/.4)}.ds-finds-strip:focus-visible{outline:3px solid #16161b;outline-offset:3px}.ds-finds-strip span{display:block;padding:10px 12px}.ds-s1{background:var(--pale);color:var(--deep);font:700 19px/1.1 \"Bricolage Grotesque\",system-ui,sans-serif;min-height:150px}.ds-s2{background:var(--tone);color:var(--deep);font-size:13px;font-weight:600;min-height:58px}.ds-s3{background:var(--deep);color:#fff;font-size:13px;font-weight:600;min-height:96px;display:flex!important;justify-content:space-between;align-items:flex-end}"
    },
    {
      "name": "Finds Tabs",
      "kind": "nav",
      "refersTo": "finds-tab",
      "scope": "public-shop",
      "description": "Sticky outlined pills with a tone swatch; only the current tab is filled with its deep.",
      "html": "<nav class=\"ds-finds-tabs\"><a href=\"#\">All</a><a href=\"#\" aria-current=\"true\" style=\"--tone:#f4adb6;--deep:#741c30\"><i></i>Skincare</a><a href=\"#\" style=\"--tone:#f2cd55;--deep:#4f3a04\"><i></i>Home</a></nav>",
      "css": ".ds-finds-tabs{display:flex;gap:8px;padding:10px 0;font-family:\"Hanken Grotesk\",system-ui,sans-serif;border-bottom:1px solid #e6e4ea;background:rgb(255 255 255/.96)}.ds-finds-tabs a{display:flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:#16161b;text-decoration:none;padding:7px 12px 7px 9px;border-radius:999px;border:1px solid #e6e4ea;transition:border-color .2s}.ds-finds-tabs a:hover{border-color:#16161b}.ds-finds-tabs a:focus-visible{outline:3px solid #16161b;outline-offset:3px}.ds-finds-tabs i{width:12px;height:12px;border-radius:3px;background:var(--tone)}.ds-finds-tabs a[aria-current=\"true\"]{background:var(--deep);color:#fff;border-color:var(--deep)}.ds-finds-tabs a[aria-current=\"true\"] i{box-shadow:0 0 0 2px #fff}"
    },
    {
      "name": "Finds Label Call-out",
      "kind": "custom",
      "refersTo": "finds-chip",
      "scope": "public-shop",
      "description": "Square pale box with a 2px deep border and two corner blocks, holding the label facts.",
      "html": "<div class=\"ds-finds-callout\" style=\"--pale:#fde4e6;--deep:#741c30\"><h2>On the label</h2><ul><li>Exfoliating</li><li>Toning</li></ul></div>",
      "css": ".ds-finds-callout{position:relative;width:260px;border:2px solid var(--deep);background:var(--pale);color:var(--deep);padding:14px 16px 12px;font-family:\"Hanken Grotesk\",system-ui,sans-serif}.ds-finds-callout::before,.ds-finds-callout::after{content:\"\";position:absolute;width:12px;height:12px;background:var(--deep)}.ds-finds-callout::before{top:-2px;left:-2px}.ds-finds-callout::after{bottom:-2px;right:-2px}.ds-finds-callout h2{margin:0 0 6px;font:700 14px/1.2 inherit}.ds-finds-callout ul{list-style:none;margin:0;padding:0;font-size:16px}"
    },
    {
      "name": "Finds Disclosure Bar",
      "kind": "custom",
      "refersTo": "finds-ad-bar",
      "scope": "public-shop",
      "description": "First thing on every public page.",
      "html": "<p class=\"ds-finds-ad\"><b>#ad</b> · Affiliate links: I may earn a commission.</p>",
      "css": ".ds-finds-ad{margin:0;background:#16161b;color:#fff;font:13px/1.4 \"Hanken Grotesk\",system-ui,sans-serif;padding:8px 16px;text-align:center}"
    },
