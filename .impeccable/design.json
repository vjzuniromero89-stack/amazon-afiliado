      "html": "<input class=\"ds-app-input\" placeholder=\"Search\">",
      "css": ".ds-app-input{min-height:48px;padding:11px 13px;border:1.5px solid #7b8ca4;border-radius:9px;background:#fff;color:#14233a;font:16px \"Atkinson Hyperlegible Next\",\"Segoe UI\",Arial,sans-serif}.ds-app-input:hover{border-color:#2a4b7d}.ds-app-input:focus-visible{outline:3px solid #2563eb;outline-offset:1px;border-color:#1c3863}"
    }
  ],
  "narrative": {
    "northStar": "The Paint-Chip Rack",
    "northStarScope": "public-shop",
    "overview": "Each kind of find is a color family, and each product is a numbered chip pulled from that family's strip. The page is a white wall with near-black ink. Color carries the navigation: you pick a color first, then a product. Categories are laid down at full strength in three shades and never tinted down or mixed. One heavy grotesque names things and one plain grotesque prints the small print. Photos sit on top of every chip, and every chip ends with an ink bar that goes to the store.",
    "privateAppOverview": "Navy and orange, built to be read. Chosen by the user on 2026-10-16 to replace the pale green-on-white look that was hard to read. All tokens live at the top of src/app/globals.css.",
    "keyCharacteristics": [
      "White wall (`finds-wall`), near-black ink (`finds-ink`), and eleven three-shade category families (pale, tone, deep).",
      "One chip module repeated across the page as the unit of measure: square photo, tone body, short name, chip number, facts, ink CTA bar.",
      "Every product carries a chip number in tabular figures (`IF 001`).",
      "The disclosure bar is always the first thing on the page, and the disclosure repeats in the footer."
    ],
    "rules": [
      {
        "name": "The Three-Shade Rule",
        "section": "colors",
        "scope": "public-shop",
        "body": "A category uses only its own pale, tone and deep, at full strength. Text on pale or tone is always that family's deep. Text on deep is always white. Adding a category means adding a whole family (all three shades, with the deep passing contrast on both lighter shades) to `ui.tsx`, never one loose color."
      },
      {
        "name": "The One Reserved Accent Rule",
        "section": "colors",
        "scope": "public-shop",
        "body": "Among the tabs, only the strip on screen gets filled: deep background, white text. \"All\" holds that fill above the first section. No other control gets that filled-tab look."
      },
      {
        "name": "The Ink Basin Rule",
        "section": "colors",
        "scope": "public-shop",
        "body": "The newest finds (at most two, for 21 days) wear their family's deep shade as the chip body, with a tone-colored \"New\" flag. Every other chip uses the tone."
      },
      {
        "name": "The Numbered Chip Rule",
        "section": "typography",
        "scope": "public-shop",
        "body": "Every product shows its chip number (`IF` plus three digits, tabular figures) directly after its name, never above it."
      },
      {
        "name": "The Pulled Chip Rule",
        "section": "elevation",
        "scope": "public-shop",
        "body": "Depth means \"this can be pulled from the rack.\" Bands, panels, tabs and the call-out stay flat. Motion uses `cubic-bezier(0.16, 1, 0.3, 1)` (0.45s for strips, 0.6s for the 1.04 photo zoom on hover), and both are removed under reduced motion."
      }
    ],
    "dos": [
      "**Do** set every category element's colors through `--pale`, `--tone` and `--deep` from the `ui.tsx` families.",
      "**Do** keep the disclosure bar first on every page and repeat it in the footer.",
      "**Do** end every chip with the ink CTA bar and show its chip number in tabular figures.",
      "**Do** keep focus visible: 3px ink outline, 3px offset.",
      "**Do** keep finds styles scoped under the `.page` wrapper so they never leak into the private app, and keep neutralizing the private app's global nav, main, footer and heading styles there."
    ],
    "donts": [
      "**Don't** use the private app's navy, orange or Atkinson Hyperlegible anywhere in the public shop, and don't use finds tokens in the private app.",
      "**Don't** tint, blend or gradient a family, or put a second family's color inside a category.",
      "**Don't** fill any control other than the current tab with the deep accent.",
      "**Don't** add prices, sale badges or red deal styling. The only flag is \"New\".",
      "**Don't** put labels or chip numbers above headings."
    ],
    "privateAppRules": [
      "Never white text on orange (fails contrast).",
      "No eyebrow labels above headings, no thick colored edge borders on rounded cards, no glow decorations.",
      "Mobile (≤720px): sidebar becomes a drawer, grids collapse to one column."
    ]
  }
}
